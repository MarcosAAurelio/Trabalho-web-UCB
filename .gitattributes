# Normaliza arquivos de texto e mantém LF no repositório.
* text=auto
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.svg text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.nojekyll text eol=lf
LICENSE text eol=lf

# Preserva os bytes de imagens e fontes.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
